# Hustly — environment template. PLACEHOLDERS ONLY. Never put a real secret here.
# Production URL (slug locked by David): https://hustlyapp.vercel.app
NEXT_PUBLIC_APP_URL=https://hustlyapp.vercel.app

# Supabase (set in Vercel dashboard / deployment secrets, never in code)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin password gate for /admin (server-side only). The password value is
# set in the Vercel dashboard, never in this repo or in chat.
ADMIN_PASSWORD=

# Groq — server-side only. Read only from process.env.GROQ_API_KEY in server routes.
# The key David supplied is set in the Vercel dashboard, never in this repo.
GROQ_API_KEY=

# Dedicated Gmail for email-OTP sending (SMTP / app password). Server-side only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=techdavid211@gmail.com
SMTP_PASS=
SMTP_FROM=techdavid211@gmail.com
